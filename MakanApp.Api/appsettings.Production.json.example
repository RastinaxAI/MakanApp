{
  "Otp": {
    "Enabled": true,
    "AllowMockAuthentication": false
  },
  "ConnectionStrings": {
    "MakanDatabase": ""
  },
  "Identity": {
    "Otp": { "Mode": "Real" },
    "SecurityKey": ""
  },
  "Cors": {
    "AllowAnyOrigin": true,
    "AllowedOrigins": []
  },
  "Hosting": {
    "RequireHttps": true,
    "AllowInsecureHttp": false,
    "HstsDays": 365
  },
  "Database": {
    "AllowUntrustedServerCertificate": false
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownProxies": ["127.0.0.1", "::1"]
  },
  "Swagger": {
    "Enabled": false
  },
  "Sms": {
    "Provider": "MeliPayamakOtp",
    "MeliPayamakOtp": {
      "BaseUrl": "https://console.melipayamak.com",
      "ServiceToken": "",
      "TimeoutSeconds": 10
    }
  },
  "Payments": {
    "Provider": "Unavailable",
    "InitiationClaimLeaseSeconds": 30,
    "Zibal": {
      "BaseUrl": "https://gateway.zibal.ir",
      "Merchant": "",
      "CallbackUrl": "",
      "ClientReturnUrl": "",
      "AllowedClientReturnOrigins": [],
      "TimeoutSeconds": 15
    }
  },
  "Messaging": {
    "ContentSafetyProvider": "Internal"
  },
  "Notifications": {
    "PushProvider": "Unavailable",
    "SmsProvider": "Unavailable",
    "WebPush": {
      "VapidSubject": "",
      "VapidPublicKey": "",
      "VapidPrivateKey": "",
      "TimeToLiveSeconds": 3600
    }
  },
  "AiService": { "Enabled": false },
  "Storage": {
    "RootPath": "C:\\MakanAppData\\Production\\Storage"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}

{
  "Otp": {
    "Enabled": false,
    "AllowMockAuthentication": false
  },
  "ConnectionStrings": {
    "MakanDatabase": ""
  },
  "Identity": {
    "Otp": {
      "Mode": "Real",
      "LifetimeSeconds": 300,
      "ResendDelaySeconds": 30,
      "RateLimitWindowSeconds": 3600,
      "MaxRequestsPerWindow": 5,
      "MaxFailedAttempts": 5,
      "MinimumCodeLength": 4,
      "MaximumCodeLength": 64
    },
    "Session": {
      "AccessLifetimeSeconds": 3600,
      "RefreshLifetimeSeconds": 2592000,
      "MaximumDeviceNameLength": 100
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Hosting": {
    "RequireHttps": true,
    "AllowInsecureHttp": false,
    "HstsDays": 365
  },
  "Database": {
    "AllowUntrustedServerCertificate": false
  },
  "ReverseProxy": {
    "Enabled": false,
    "KnownProxies": []
  },
  "Swagger": {
    "Enabled": true
  },
  "Sms": {
    "Provider": "Unavailable",
    "MeliPayamakOtp": {
      "BaseUrl": "https://console.melipayamak.com",
      "TimeoutSeconds": 10
    }
  },
  "Notifications": {
    "PushProvider": "Unavailable",
    "SmsProvider": "Unavailable",
    "Delivery": {
      "BatchSize": 50,
      "ClaimLeaseSeconds": 30,
      "IdlePollingSeconds": 2,
      "InitialRetryDelaySeconds": 5,
      "MaximumRetryDelaySeconds": 300,
      "ProviderTimeoutSeconds": 10,
      "MaximumAttempts": 3
    }
  },
  "Payments": {
    "Provider": "Unavailable",
    "InitiationClaimLeaseSeconds": 30
  },
  "AiService": {
    "Enabled": false,
    "BaseUrl": "http://10.77.0.2:8001",
    "TimeoutSeconds": 180,
    "ContractVersion": "v1",
    "CircuitBreakerFailureThreshold": 3,
    "CircuitBreakerBreakSeconds": 30,
    "Authentication": {
      "Issuer": "makan-backend",
      "Audience": "makan-ai",
      "ServiceName": "makan-backend",
      "Scope": "makan.ai.invoke",
      "CurrentKeyId": "",
      "CurrentKey": "",
      "TokenLifetimeSeconds": 120
    }
  },
  "Storage": {
    "RootPath": "",
    "MaxFileSizeBytes": 10485760,
    "UnattachedLifetimeHours": 24,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/plain"
    ]
  },
  "Messaging": {
    "MaximumTextLength": 4000,
    "DefaultHistoryLimit": 50,
    "MaximumHistoryLimit": 100
  },
  "Reports": {
    "Exports": {
      "MaximumRows": 10000,
      "PageSize": 100,
      "MaximumFileSizeBytes": 20971520,
      "ClaimLeaseSeconds": 120,
      "IdlePollingSeconds": 2,
      "RetryDelaySeconds": 10,
      "MaximumAttempts": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

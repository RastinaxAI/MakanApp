{
  "ConnectionStrings": {
    "MakanDatabase": ""
  },
  "Identity": {
    "Otp": {
      "LifetimeSeconds": 300,
      "ResendDelaySeconds": 30,
      "RateLimitWindowSeconds": 3600,
      "MaxRequestsPerWindow": 5,
      "MaxFailedAttempts": 5,
      "MinimumCodeLength": 4,
      "MaximumCodeLength": 64
    },
    "Session": {
      "LifetimeSeconds": 2592000
    }
  },
  "Sms": {
    "Provider": "Unavailable",
    "MeliPayamakOtp": {
      "BaseUrl": "https://console.melipayamak.com",
      "TimeoutSeconds": 10
    }
  },
  "Storage": {
    "RootPath": "",
    "MaxFileSizeBytes": 10485760,
    "UnattachedLifetimeHours": 24,
    "AllowedContentTypes": [
      "application/pdf",
      "image/jpeg",
      "image/png",
      "text/plain"
    ]
  },
  "Messaging": {
    "MaximumTextLength": 4000,
    "DefaultHistoryLimit": 50,
    "MaximumHistoryLimit": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}

<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\MakanApp.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" shutdownTimeLimit="120">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- مسیر پایدار مخصوص IIS؛ هنگام بازنشر، مسیر و کلیدهای موجود سرور را حفظ کنید. -->
          <environmentVariable name="BackofficeSecurity__KeyRingPath" value="C:\ProgramData\MakanApp\BackofficeMfaKeys" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>

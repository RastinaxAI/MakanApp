<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <Configuration>Release</Configuration>
    <EnvironmentName>Test</EnvironmentName>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- فایل‌های خصوصی و توسعه نباید وارد بستهٔ سرور تست شوند. -->
    <Content Update="appsettings.Production.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>

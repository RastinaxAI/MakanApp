<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <Configuration>Release</Configuration>
    <EnvironmentName>Production</EnvironmentName>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <!-- سمبل‌های توسعه وارد بستهٔ سرور نمی‌شوند. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <!-- کانفیگ Mock و توسعه نباید وارد بستهٔ Production شوند. -->
    <Content Update="appsettings.Test.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
  <Target Name="ExcludeServerPublishSymbols" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <!-- سمبل پروژه‌های وابسته نیز باید از artifact نهایی حذف شود. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>

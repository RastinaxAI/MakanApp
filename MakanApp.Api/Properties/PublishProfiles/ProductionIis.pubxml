<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <Configuration>Release</Configuration>
    <EnvironmentName>Production</EnvironmentName>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>
  <ItemGroup>
    <!-- کانفیگ Mock و توسعه نباید وارد بستهٔ Production شوند. -->
    <Content Update="appsettings.Test.json;appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>

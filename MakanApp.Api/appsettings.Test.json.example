{
  "Otp": {
    "Enabled": false,
    "AllowMockAuthentication": true
  },
  "ConnectionStrings": {
    "MakanDatabase": ""
  },
  "Identity": {
    "Otp": { "Mode": "Real" },
    "SecurityKey": ""
  },
  "Cors": {
    "AllowedOrigins": ["https://app.example.test"]
  },
  "Hosting": {
    "RequireHttps": true,
    "AllowInsecureHttp": false,
    "HstsDays": 365
  },
  "Database": {
    "AllowUntrustedServerCertificate": false
  },
  "ReverseProxy": {
    "Enabled": true,
    "KnownProxies": ["127.0.0.1", "::1"]
  },
  "Swagger": {
    "Enabled": true
  },
  "Sms": {
    "Provider": "MeliPayamakOtp",
    "MeliPayamakOtp": {
      "BaseUrl": "https://console.melipayamak.com",
      "ServiceToken": "",
      "TimeoutSeconds": 10
    }
  },
  "Payments": {
    "Provider": "Unavailable"
  },
  "Messaging": {
    "ContentSafetyProvider": "Internal"
  },
  "Notifications": {
    "PushProvider": "Unavailable",
    "SmsProvider": "Unavailable"
  },
  "Storage": {
    "RootPath": "C:\\MakanAppData\\Test\\Storage"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "api.example.test"
}
